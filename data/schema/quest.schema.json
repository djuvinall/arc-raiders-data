{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_Quest",
  "type": "array",
  "items": {
    "$ref": "#/$defs/Quest"
  },
  "$defs": {
    "Quest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "trader": {
          "type": [
            "string",
            "null"
          ]
        },
        "cadence": {
          "type": "string"
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestPrereq"
          }
        },
        "objective_root": {
          "type": "string"
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Objective"
          }
        },
        "required_items": {
          "description": "Items handed in; the plan's \"quest reqs\" live here rather than on objectives.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemQty"
          }
        },
        "rewards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemQty"
          }
        },
        "xp": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "graph_position": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphPosition"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "cadence",
        "prerequisites",
        "objective_root",
        "objectives",
        "required_items",
        "rewards",
        "provenance"
      ]
    },
    "QuestPrereq": {
      "type": "object",
      "properties": {
        "quest_id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "quest_id",
        "state"
      ]
    },
    "Objective": {
      "description": "`sequence` nodes group `children`; `atomic` nodes are one objective. The API\npublishes objectives as plain strings today, so `action` is null until tagged.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "round_constraint": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuestAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "amount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "maps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "poi_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "item_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maps_provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "children",
        "maps",
        "poi_ids",
        "item_ids"
      ]
    },
    "QuestAction": {
      "type": "string",
      "enum": [
        "interact",
        "visit_poi",
        "collect",
        "kill",
        "extract",
        "deliver"
      ]
    },
    "Provenance": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "api",
            "wiki",
            "community_measured",
            "hand_entered"
          ]
        },
        {
          "description": "RaidTheory community JSON; added to the plan's list so fallback rows stay visible.",
          "type": "string",
          "const": "community"
        }
      ]
    },
    "ItemQty": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string"
        },
        "qty": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "item_id",
        "qty"
      ]
    },
    "GraphPosition": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ]
    }
  }
}
