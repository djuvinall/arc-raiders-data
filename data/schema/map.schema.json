{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_GameMap",
  "type": "array",
  "items": {
    "$ref": "#/$defs/GameMap"
  },
  "$defs": {
    "GameMap": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/MapImage"
        },
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bounds"
            },
            {
              "type": "null"
            }
          ]
        },
        "poi_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "event_pool": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "image",
        "poi_ids",
        "event_pool"
      ]
    },
    "MapImage": {
      "type": "object",
      "properties": {
        "url": {
          "description": "Tile template on MetaForge's CDN, fetched and cached at runtime, never committed.",
          "type": [
            "string",
            "null"
          ]
        },
        "width_px": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "height_px": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "tile_size": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "max_native_zoom": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "world_extent": {
          "description": "[lat, lng, lat, lng] corners of the map in marker coordinates...",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "tile_extent": {
          "description": "...and the same corners in zoom-0 tile pixels [y, x, y, x].",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "layers": {
          "description": "Floors, first one shown by default. Empty on one-floor maps.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapLayer"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "layers"
      ]
    },
    "MapLayer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "mask": {
          "description": "The bit a marker's `zlayers` sets when it's on this floor.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "mask"
      ]
    },
    "Bounds": {
      "type": "object",
      "properties": {
        "x_min": {
          "type": "number",
          "format": "double"
        },
        "x_max": {
          "type": "number",
          "format": "double"
        },
        "y_min": {
          "type": "number",
          "format": "double"
        },
        "y_max": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "x_min",
        "x_max",
        "y_min",
        "y_max"
      ]
    }
  }
}
