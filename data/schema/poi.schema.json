{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_Poi",
  "type": "array",
  "items": {
    "$ref": "#/$defs/Poi"
  },
  "$defs": {
    "Poi": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "map_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PoiKind"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "loot_areas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "zlayers": {
          "description": "Bitmask of the floors it's on, as MetaForge reports it.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "quest_id": {
          "description": "On quest pins: the quest it belongs to.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "map_id",
        "name",
        "kind",
        "x",
        "y",
        "loot_areas"
      ]
    },
    "PoiKind": {
      "type": "string",
      "enum": [
        "building",
        "landmark",
        "extract",
        "arc-spawn",
        "cache",
        "quest-target"
      ]
    }
  }
}
