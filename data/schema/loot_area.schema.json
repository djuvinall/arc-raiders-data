{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_LootArea",
  "type": "array",
  "items": {
    "$ref": "#/$defs/LootArea"
  },
  "$defs": {
    "LootArea": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "item_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "item_ids"
      ]
    }
  }
}
