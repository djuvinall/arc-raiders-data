{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_Arc",
  "type": "array",
  "items": {
    "$ref": "#/$defs/Arc"
  },
  "$defs": {
    "Arc": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "class": {
          "type": [
            "string",
            "null"
          ]
        },
        "hp": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "armor": {
          "type": [
            "string",
            "null"
          ]
        },
        "attack": {
          "type": [
            "string",
            "null"
          ]
        },
        "ability": {
          "type": [
            "string",
            "null"
          ]
        },
        "weak_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tips": {
          "type": [
            "string",
            "null"
          ]
        },
        "armor_zones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArmorZone"
          }
        },
        "drops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArcDrop"
          }
        },
        "source_refs": {
          "$ref": "#/$defs/SourceRefs"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "weak_points",
        "armor_zones",
        "drops",
        "source_refs",
        "provenance"
      ]
    },
    "ArmorZone": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string"
        },
        "hp": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "weak_point": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "zone",
        "weak_point"
      ]
    },
    "ArcDrop": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string"
        },
        "chance": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "item_id"
      ]
    },
    "SourceRefs": {
      "type": "object",
      "properties": {
        "metaforge": {
          "type": [
            "string",
            "null"
          ]
        },
        "wiki": {
          "type": [
            "string",
            "null"
          ]
        },
        "raidtheory": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Provenance": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "api",
            "wiki",
            "community_measured",
            "hand_entered"
          ]
        },
        {
          "description": "RaidTheory community JSON; added to the plan's list so fallback rows stay visible.",
          "type": "string",
          "const": "community"
        }
      ]
    }
  }
}
