{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Notes",
  "description": "data/notes.json: hand-entered facts no source publishes, from notes_overlay.json.\nOptional, so data without it (and apps from before it) still load.",
  "type": "object",
  "properties": {
    "items": {
      "description": "Where to find an item, by item id.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ItemNote"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "$defs": {
    "ItemNote": {
      "type": "object",
      "properties": {
        "where": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "where",
        "source"
      ]
    }
  }
}
