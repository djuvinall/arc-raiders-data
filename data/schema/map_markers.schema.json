{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MapMarkers",
  "description": "Every marker on every map, compact, for drawing. Routing uses `Poi` instead.",
  "type": "object",
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MarkerCategory"
      }
    },
    "maps": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/MapMarker"
        }
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "categories",
    "maps"
  ],
  "$defs": {
    "MarkerCategory": {
      "type": "object",
      "properties": {
        "id": {
          "description": "`containers/locker`, or `quests` for every quest objective.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "group": {
          "description": "`locations`, `containers`, `arc`, `nature`, `events` or `quests`.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "group"
      ]
    },
    "MapMarker": {
      "description": "`[category index, x, y, floors bitmask, label]`. Quest markers carry the quest id as label.",
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        {
          "type": [
            "string",
            "null"
          ]
        }
      ],
      "minItems": 5,
      "maxItems": 5
    }
  }
}
