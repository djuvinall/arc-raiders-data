{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_Trader",
  "type": "array",
  "items": {
    "$ref": "#/$defs/Trader"
  },
  "$defs": {
    "Trader": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "inventory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TraderStock"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "inventory"
      ]
    },
    "TraderStock": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string"
        },
        "price": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "daily_limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "item_id",
        "price"
      ]
    }
  }
}
