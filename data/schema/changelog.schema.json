{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_ChangelogEntry",
  "type": "array",
  "items": {
    "$ref": "#/$defs/ChangelogEntry"
  },
  "$defs": {
    "ChangelogEntry": {
      "description": "One row of data/changelog.json, generated by `arc-ingest sync --write` (Phase 6).",
      "type": "object",
      "properties": {
        "dataset_version": {
          "type": "string"
        },
        "game_patch": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileChange"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "dataset_version",
        "summary",
        "files"
      ]
    },
    "FileChange": {
      "description": "What one ingest changed in one file. Names, capped so a big patch stays readable.",
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "added",
        "removed",
        "changed"
      ]
    }
  }
}
