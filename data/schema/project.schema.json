{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_Project",
  "type": "array",
  "items": {
    "$ref": "#/$defs/Project"
  },
  "$defs": {
    "Project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectStage"
          }
        },
        "deadline_days": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "expedition": {
          "type": "boolean"
        },
        "starts": {
          "description": "Dates as YYYY-MM-DD, null when no source gives one.",
          "type": [
            "string",
            "null"
          ]
        },
        "ends": {
          "type": [
            "string",
            "null"
          ]
        },
        "permanent": {
          "description": "Runs with no end date.",
          "type": "boolean"
        },
        "paused": {
          "description": "On the in-game page but closed for now.",
          "type": "boolean"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "stages",
        "expedition",
        "permanent",
        "paused",
        "provenance"
      ]
    },
    "ProjectStage": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "title": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemQty"
          }
        },
        "rewards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemQty"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "n",
        "title",
        "inputs",
        "rewards"
      ]
    },
    "ItemQty": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string"
        },
        "qty": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "item_id",
        "qty"
      ]
    },
    "Provenance": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "api",
            "wiki",
            "community_measured",
            "hand_entered"
          ]
        },
        {
          "description": "RaidTheory community JSON; added to the plan's list so fallback rows stay visible.",
          "type": "string",
          "const": "community"
        }
      ]
    }
  }
}
