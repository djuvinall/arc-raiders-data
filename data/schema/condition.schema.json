{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_MapCondition",
  "type": "array",
  "items": {
    "$ref": "#/$defs/MapCondition"
  },
  "$defs": {
    "MapCondition": {
      "description": "A map condition (event) and how it changes loot, for the raid planner.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "major": {
          "description": "Embark's major/minor tag; None when the official tracker doesn't list it.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "maps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "loot_value": {
          "description": "Scales chances for rare-and-up items while it's live: above 1 for \"increased loot\nvalue\", below for \"decreased\". An estimate; the game gives no numbers.",
          "type": "number",
          "format": "double"
        },
        "boosts": {
          "description": "Marker types that spawn more often while it's live.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/MarkerBoost"
          }
        },
        "loot_effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "arc_effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "maps",
        "loot_value",
        "boosts",
        "loot_effects",
        "arc_effects",
        "confidence"
      ]
    },
    "MarkerBoost": {
      "type": "object",
      "properties": {
        "marker": {
          "type": "string"
        },
        "factor": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "marker",
        "factor"
      ]
    }
  }
}
