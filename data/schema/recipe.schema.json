{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_Recipe",
  "type": "array",
  "items": {
    "$ref": "#/$defs/Recipe"
  },
  "$defs": {
    "Recipe": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RecipeKind"
        },
        "output": {
          "description": "Craft and trade. Recycle and salvage use `outputs`.",
          "anyOf": [
            {
              "$ref": "#/$defs/ItemQty"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemQty"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemQty"
          }
        },
        "workbench_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "workbench_level": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "alt_stations": {
          "description": "Other stations that can make this (\"Workbench 1, Gunsmith 1\" on the wiki).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Station"
          }
        },
        "requires_blueprint": {
          "type": "boolean"
        },
        "blueprint_item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "craft_time_s": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "source_refs": {
          "$ref": "#/$defs/SourceRefs"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "outputs",
        "inputs",
        "alt_stations",
        "requires_blueprint",
        "source_refs",
        "provenance"
      ]
    },
    "RecipeKind": {
      "description": "`salvage` is added to the plan's list: the wiki separates it from `recycle`\nand the yields differ (Rattler I: 8 metal parts recycled, 4 salvaged).",
      "type": "string",
      "enum": [
        "craft",
        "recycle",
        "salvage",
        "trade",
        "project-stage"
      ]
    },
    "ItemQty": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string"
        },
        "qty": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "item_id",
        "qty"
      ]
    },
    "Station": {
      "type": "object",
      "properties": {
        "workbench_id": {
          "type": "string"
        },
        "level": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        }
      },
      "additionalProperties": false,
      "required": [
        "workbench_id"
      ]
    },
    "SourceRefs": {
      "type": "object",
      "properties": {
        "metaforge": {
          "type": [
            "string",
            "null"
          ]
        },
        "wiki": {
          "type": [
            "string",
            "null"
          ]
        },
        "raidtheory": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Provenance": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "api",
            "wiki",
            "community_measured",
            "hand_entered"
          ]
        },
        {
          "description": "RaidTheory community JSON; added to the plan's list so fallback rows stay visible.",
          "type": "string",
          "const": "community"
        }
      ]
    }
  }
}
